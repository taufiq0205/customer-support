# CX Support Tool — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to the project root).
DATABASE_URL=./cx_tool.db

# ─── Session ─────────────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# ─── Zaapi Integration ───────────────────────────────────────────────────────
# API key for authenticating outbound requests to the Zaapi REST API.
ZAAPI_API_KEY=your-zaapi-api-key-here

# Shared secret for verifying HMAC signatures on inbound Zaapi webhook events.
ZAAPI_WEBHOOK_SECRET=your-zaapi-webhook-secret-here

# ─── respond.io Integration ──────────────────────────────────────────────────
# API key for authenticating outbound requests to the respond.io REST API.
RESPOND_IO_API_KEY=your-respond-io-api-key-here

# Shared secret for verifying HMAC signatures on inbound respond.io webhook events.
RESPOND_IO_WEBHOOK_SECRET=your-respond-io-webhook-secret-here

# ─── AI Integration ──────────────────────────────────────────────────────────
# Base URL of the OpenAI-compatible chat completions endpoint.
# Examples:
#   https://api.openai.com          (OpenAI)
#   https://api.deepseek.com        (DeepSeek)
#   http://localhost:11434          (Ollama)
AI_ENDPOINT_URL=http://localhost:11434

# Model identifier passed in the chat completions request body.
AI_MODEL_NAME=deepseek-r1:7b

# API key for the AI endpoint (leave blank if the endpoint requires no auth).
AI_API_KEY=your-ai-api-key-here
